<%- include('../partials/header') %>

<section class="admin-page">
  <div class="container admin-form-container">
    <div class="page-header">
      <div class="admin-breadcrumb">
        <a href="/admin/products">&larr; Back to Product Management</a>
      </div>
      <h1 class="page-title"><%= isEdit ? `Edit Product: ${product.name}` : 'Add New Product' %></h1>
      <p class="page-subtitle">
        <%= isEdit ? 'Update product details, pricing, and available inventory stock.' : 'Fill in the information below to introduce a new item into the store catalog.' %>
      </p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error" role="alert">
        <span class="alert-icon">⚠</span>
        <span><%= error %></span>
      </div>
    <% } %>

    <div class="admin-card">
      <form 
        action="<%= isEdit ? `/admin/products/${product._id}/edit` : '/admin/products/new' %>" 
        method="POST" 
        class="standard-form"
        id="product-form"
      >
        <div class="form-group">
          <label for="name" class="form-label">Product Name <span class="required">*</span></label>
          <input 
            type="text" 
            id="name" 
            name="name" 
            class="form-input" 
            placeholder="e.g. Ceramic Pour-Over Dripper" 
            value="<%= product.name || '' %>" 
            required
          >
        </div>

        <div class="form-row form-row-2">
          <div class="form-group">
            <label for="category" class="form-label">Category <span class="required">*</span></label>
            <input 
              type="text" 
              id="category" 
              name="category" 
              class="form-input" 
              placeholder="e.g. Kitchen Accessories" 
              value="<%= product.category || '' %>" 
              list="category-suggestions"
              required
            >
            <datalist id="category-suggestions">
              <option value="Home Essentials">
              <option value="Kitchen Accessories">
              <option value="Office Supplies">
              <option value="Lifestyle">
            </datalist>
          </div>

          <div class="form-group">
            <label for="price" class="form-label">Price (USD) <span class="required">*</span></label>
            <input 
              type="number" 
              step="0.01" 
              min="0" 
              id="price" 
              name="price" 
              class="form-input" 
              placeholder="29.99" 
              value="<%= typeof product.price !== 'undefined' ? product.price : '' %>" 
              required
            >
          </div>
        </div>

        <div class="form-row form-row-2">
          <div class="form-group">
            <label for="stock" class="form-label">Available Stock <span class="required">*</span></label>
            <input 
              type="number" 
              min="0" 
              id="stock" 
              name="stock" 
              class="form-input" 
              placeholder="10" 
              value="<%= typeof product.stock !== 'undefined' ? product.stock : 10 %>" 
              required
            >
          </div>

          <div class="form-group">
            <label for="image" class="form-label">Image URL <span class="required">*</span></label>
            <input 
              type="url" 
              id="image" 
              name="image" 
              class="form-input" 
              placeholder="https://images.unsplash.com/..." 
              value="<%= product.image || '' %>" 
              required
            >
          </div>
        </div>

        <div class="form-group">
          <label for="description" class="form-label">Product Description <span class="required">*</span></label>
          <textarea 
            id="description" 
            name="description" 
            rows="5" 
            class="form-textarea" 
            placeholder="Write a clear, concise description of the product and its key features..." 
            required
          ><%= product.description || '' %></textarea>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary btn-lg" id="btn-save-product">
            <%= isEdit ? 'Save Changes' : 'Create Product' %>
          </button>
          <a href="/admin/products" class="btn btn-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
