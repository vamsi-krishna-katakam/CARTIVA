<%- include('partials/header') %>

<section class="order-details-page">
  <div class="container">
    <!-- Post-Checkout Success Banner (if confirmation) -->
    <% if (typeof isConfirmation !== 'undefined' && isConfirmation) { %>
      <div class="confirmation-hero">
        <div class="confirmation-icon">🎉</div>
        <h1 class="confirmation-title">Order Placed Successfully!</h1>
        <p class="confirmation-subtitle">
          Thank you for shopping with CARTIVA. Your order has been registered in MongoDB and is currently being processed.
        </p>
      </div>
    <% } %>

    <div class="order-detail-card">
      <div class="order-detail-header">
        <div>
          <span class="detail-order-number">Order #<%= order._id.toString().toUpperCase() %></span>
          <div class="detail-order-date">
            Placed on <%= new Date(order.createdAt).toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
          </div>
        </div>
        <div class="order-status-badge status-<%= order.status.toLowerCase() %>">
          Status: <%= order.status %>
        </div>
      </div>

      <div class="order-sections-grid">
        <!-- Shipping Details Column -->
        <div class="order-info-block">
          <h2 class="block-title">Shipping Address</h2>
          <div class="address-box">
            <p class="address-recipient"><strong><%= order.shippingAddress.fullName %></strong></p>
            <p><%= order.shippingAddress.address %></p>
            <p><%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> <%= order.shippingAddress.postalCode %></p>
          </div>
        </div>

        <!-- Payment Info Column -->
        <div class="order-info-block">
          <h2 class="block-title">Payment Method</h2>
          <div class="payment-box">
            <p><strong>Demo Mode (Mock Payment)</strong></p>
            <p class="text-muted">Payment status: Verified & Cleared</p>
          </div>
        </div>
      </div>

      <!-- Items Table -->
      <div class="order-items-table-wrapper">
        <h2 class="block-title">Ordered Items</h2>
        <table class="order-items-table">
          <thead>
            <tr>
              <th>Item Name</th>
              <th>Unit Price</th>
              <th>Quantity</th>
              <th class="text-right">Subtotal</th>
            </tr>
          </thead>
          <tbody>
            <% order.items.forEach(item => { %>
              <tr>
                <td>
                  <span class="order-item-name"><%= item.name %></span>
                </td>
                <td>$<%= item.price.toFixed(2) %></td>
                <td><%= item.quantity %></td>
                <td class="text-right">$<%= (item.price * item.quantity).toFixed(2) %></td>
              </tr>
            <% }); %>
          </tbody>
          <tfoot>
            <tr>
              <td colspan="3" class="text-right"><strong>Subtotal:</strong></td>
              <td class="text-right">$<%= order.total.toFixed(2) %></td>
            </tr>
            <tr>
              <td colspan="3" class="text-right"><strong>Standard Shipping:</strong></td>
              <td class="text-right text-free">FREE</td>
            </tr>
            <tr class="grand-total-row">
              <td colspan="3" class="text-right"><strong>Order Total:</strong></td>
              <td class="text-right"><strong>$<%= order.total.toFixed(2) %></strong></td>
            </tr>
          </tfoot>
        </table>
      </div>

      <div class="order-detail-actions">
        <% if (locals.currentUser) { %>
          <a href="/orders" class="btn btn-secondary">&larr; Back to Order History</a>
        <% } %>
        <a href="/products" class="btn btn-primary">Continue Shopping &rarr;</a>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
