<%- include('partials/header') %>

<section class="catalog-page">
  <div class="container">
    <!-- Catalog Header -->
    <div class="catalog-header">
      <div>
        <h1 class="page-title">Product Catalog</h1>
        <p class="page-subtitle">
          Showing <%= products.length %> <%= products.length === 1 ? 'item' : 'items' %>
          <% if (selectedCategory && selectedCategory !== 'All') { %>
            in <strong><%= selectedCategory %></strong>
          <% } %>
          <% if (searchQuery) { %>
            matching "<strong><%= searchQuery %></strong>"
          <% } %>
        </p>
      </div>

      <!-- Filters & Sorting Control Bar -->
      <form action="/products" method="GET" class="filter-controls-form" id="filter-controls-form">
        <!-- Preserve search query if present -->
        <% if (searchQuery) { %>
          <input type="hidden" name="search" value="<%= searchQuery %>">
        <% } %>

        <!-- Category Filter Dropdown -->
        <div class="filter-group">
          <label for="filter-category" class="filter-label">Category:</label>
          <select name="category" id="filter-category" class="form-select" onchange="this.form.submit()">
            <option value="All" <%= selectedCategory === 'All' ? 'selected' : '' %>>All Categories</option>
            <% categories.forEach(cat => { %>
              <option value="<%= cat %>" <%= selectedCategory === cat ? 'selected' : '' %>><%= cat %></option>
            <% }); %>
          </select>
        </div>

        <!-- Price Sort Dropdown -->
        <div class="filter-group">
          <label for="filter-sort" class="filter-label">Sort by:</label>
          <select name="sort" id="filter-sort" class="form-select" onchange="this.form.submit()">
            <option value="" <%= !selectedSort ? 'selected' : '' %>>Newest First</option>
            <option value="price_asc" <%= selectedSort === 'price_asc' ? 'selected' : '' %>>Price: Low to High</option>
            <option value="price_desc" <%= selectedSort === 'price_desc' ? 'selected' : '' %>>Price: High to Low</option>
            <option value="name_asc" <%= selectedSort === 'name_asc' ? 'selected' : '' %>>Name: A to Z</option>
          </select>
        </div>

        <% if (searchQuery || (selectedCategory && selectedCategory !== 'All') || selectedSort) { %>
          <a href="/products" class="btn btn-outline btn-sm reset-filters-btn">Reset Filters</a>
        <% } %>
      </form>
    </div>

    <!-- Quick Category Pill Filter -->
    <div class="category-pills">
      <a href="/products<%= searchQuery ? `?search=${encodeURIComponent(searchQuery)}` : '' %>" 
         class="category-pill <%= selectedCategory === 'All' ? 'active' : '' %>">
        All
      </a>
      <% categories.forEach(cat => { %>
        <a href="/products?category=<%= encodeURIComponent(cat) %><%= searchQuery ? `&search=${encodeURIComponent(searchQuery)}` : '' %><%= selectedSort ? `&sort=${encodeURIComponent(selectedSort)}` : '' %>" 
           class="category-pill <%= selectedCategory === cat ? 'active' : '' %>">
          <%= cat %>
        </a>
      <% }); %>
    </div>

    <!-- Product Grid -->
    <% if (products && products.length > 0) { %>
      <div class="product-grid">
        <% products.forEach(product => { %>
          <div class="product-card" id="product-card-<%= product._id %>">
            <div class="product-card-media">
              <a href="/products/<%= product._id %>">
                <img 
                  src="<%= product.image %>" 
                  alt="<%= product.name %>" 
                  class="product-image"
                  loading="lazy"
                  onerror="this.onerror=null; this.src='/images/placeholder.svg';"
                >
              </a>
              <span class="product-category-tag"><%= product.category %></span>
            </div>

            <div class="product-card-body">
              <h2 class="product-title">
                <a href="/products/<%= product._id %>"><%= product.name %></a>
              </h2>
              <p class="product-description-snippet">
                <%= product.description.length > 75 ? product.description.substring(0, 75) + '...' : product.description %>
              </p>
              
              <div class="product-meta">
                <div class="product-price">$<%= product.price.toFixed(2) %></div>
                <div class="product-stock-status <%= product.stock > 0 ? 'in-stock' : 'out-of-stock' %>">
                  <%= product.stock > 0 ? (product.stock <= 5 ? `Only ${product.stock} left` : 'In Stock') : 'Out of Stock' %>
                </div>
              </div>

              <div class="product-card-actions">
                <a href="/products/<%= product._id %>" class="btn btn-secondary btn-sm" id="view-details-<%= product._id %>">View Details</a>
                <% if (product.stock > 0) { %>
                  <form action="/cart/add" method="POST" class="add-to-cart-form">
                    <input type="hidden" name="productId" value="<%= product._id %>">
                    <input type="hidden" name="quantity" value="1">
                    <button type="submit" class="btn btn-primary btn-sm" id="add-to-cart-<%= product._id %>">Add to Cart</button>
                  </form>
                <% } else { %>
                  <button class="btn btn-disabled btn-sm" disabled>Out of Stock</button>
                <% } %>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <!-- Empty State -->
      <div class="empty-state">
        <div class="empty-state-icon">🔍</div>
        <h3 class="empty-state-title">No matching products found</h3>
        <p class="empty-state-text">
          <% if (searchQuery) { %>
            We couldn't find any products matching "<strong><%= searchQuery %></strong>". Try checking for typos or searching for general terms.
          <% } else { %>
            There are currently no products available in the selected category.
          <% } %>
        </p>
        <div class="empty-state-action">
          <a href="/products" class="btn btn-primary">Browse All Products</a>
        </div>
      </div>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
